{
  "name": "mcpier",
  "version": "1.1.0",
  "private": true,
  "description": "Local Windows MCP gateway. See SPEC.md.",
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @mcpier/web build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json && pnpm --filter @mcpier/web typecheck",
    "test": "pnpm build && vitest run",
    "test:only": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "dev:web": "pnpm --filter @mcpier/web dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mcpier/cli": "workspace:*",
    "@mcpier/core": "workspace:*",
    "@mcpier/shared": "workspace:*",
    "@mcpier/test-fixtures": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
